<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pronunciation lexicon for the bus station site (British English IPA).
  Upload or update with: uv run python scripts/sync_pronunciations.py bus_station
  Matching is case-sensitive. These transcriptions are written from knowledge of how the
  names are said on the Underground: listen to each one before the pitch and adjust.
-->
<lexicon version="1.0"
         xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
         alphabet="ipa" xml:lang="en-GB">
  <lexeme><grapheme>Marylebone</grapheme><phoneme>ˈmɑːlɪbən</phoneme></lexeme>
  <lexeme><grapheme>Southwark</grapheme><phoneme>ˈsʌðək</phoneme></lexeme>
  <lexeme><grapheme>Holborn</grapheme><phoneme>ˈhəʊbən</phoneme></lexeme>
  <lexeme><grapheme>Greenwich</grapheme><phoneme>ˈɡrɛnɪtʃ</phoneme></lexeme>
  <lexeme><grapheme>Leicester Square</grapheme><phoneme>ˈlɛstə skwɛə</phoneme></lexeme>
</lexicon>
